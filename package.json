{
  "name": "@bifravst/aws-cdk-ecr-helpers",
  "version": "0.0.0-development",
  "description": "Helper functions which simplify working with Elastic Container Registry (ECR) for AWS CDK.",
  "exports": {
    "./*": {
      "import": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "husky && case \"$npm_command\" in install|ci) check-node-version --package ;; esac",
    "prepublishOnly": "npx tsc --noEmit false -d",
    "test": "node --experimental-strip-types --no-warnings --test src/*.spec.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bifravst/aws-cdk-ecr-helpers.git"
  },
  "bugs": {
    "url": "https://github.com/bifravst/aws-cdk-ecr-helpers/issues"
  },
  "homepage": "https://github.com/bifravst/aws-cdk-ecr-helpers",
  "keywords": [
    "aws",
    "cdk",
    "lambda",
    "typescript"
  ],
  "author": "Nordic Semiconductor ASA | nordicsemi.no",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@bifravst/eslint-config-typescript": "8.0.0",
    "@bifravst/prettier-config": "2.0.0",
    "@commitlint/config-conventional": "21.2.2",
    "@types/node": "26.2.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "check-node-version": "4.2.1",
    "commitlint": "21.2.2",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint"
    ],
    "*.{md,json,yaml,yml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=12.0.2 <13"
  },
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/github",
        {
          "successCommentCondition": false,
          "failTitle": false
        }
      ]
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "prettier": "@bifravst/prettier-config",
  "peerDependencies": {
    "@aws-sdk/client-ecr": ">=3.1111.0 <4",
    "@bifravst/run": ">=2.0.1 <3"
  }
}
